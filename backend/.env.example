# Copie para .env para rodar a API fora do Docker.
# cp .env.example .env

NODE_ENV=development
PORT=3001
LOG_LEVEL=debug

# MySQL (docker-compose local)
DATABASE_URL=mysql://logisense:logisense@localhost:3306/logisense

# Redis (docker-compose local)
REDIS_URL=redis://localhost:6379

# Auth — NUNCA versione valores reais. Troque em produção.
JWT_ACCESS_SECRET=dev-access-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# OAuth (Fase 4 — placeholders)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_CALLBACK_URL=http://localhost:3001/api/auth/google/callback
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GITHUB_CALLBACK_URL=http://localhost:3001/api/auth/github/callback

# Cookies (true em produção com HTTPS)
COOKIE_SECURE=false

# Frontend
CORS_ORIGINS=http://localhost:3000
