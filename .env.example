# Copie para .env na raiz para uso com docker-compose.
# cp .env.example .env

# --- Compose / MySQL ---
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=logisense
MYSQL_USER=logisense
MYSQL_PASSWORD=logisense
MYSQL_PORT=3306

# --- Redis ---
REDIS_PORT=6379

# --- API ---
API_PORT=3001

# --- Auth (troque em produção!) ---
JWT_ACCESS_SECRET=troque-este-secret-de-access
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Cifra segredos TOTP em repouso (AES-256-GCM). Obrigatória em produção.
MFA_ENCRYPTION_KEY=troque-esta-chave-de-cifra-do-mfa

# --- OAuth (Google/GitHub) ---
# Callbacks cadastrados nos provedores:
#   Google: http://localhost:3001/api/auth/google/callback
#   GitHub: http://localhost:3001/api/auth/github/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3001/api/auth/google/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:3001/api/auth/github/callback

# --- Frontend (quando existir o serviço web) ---
WEB_PORT=3000
CORS_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000
